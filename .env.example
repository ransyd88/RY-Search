# Supabase project API URL, found in Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Preferred for current Supabase projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional legacy fallback. Leave commented when using a publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_legacy_anon_key
