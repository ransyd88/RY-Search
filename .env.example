# Supabase project API URL, found in Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Preferred for current Supabase projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase secret used only for trusted AI usage-counter RPCs.
# Never expose this value to browser code or use a public prefix.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional legacy fallback. Leave commented when using a publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_legacy_anon_key

# Server-only R&Y Research Agent configuration. Never add NEXT_PUBLIC_ or VITE_ prefixes.
OPENAI_API_KEY=your_openai_api_key

# Cloudflare Turnstile login protection. The site key is public; the secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_EXPECTED_HOSTNAME=rycapital.com.au

# Optional server-enforced limits (shown values are the application defaults).
AI_DAILY_MESSAGE_LIMIT=100
AI_MAX_OUTPUT_TOKENS=2000
AI_CONTEXT_MESSAGE_LIMIT=20
AI_MAX_MESSAGE_LENGTH=20000
AI_PER_MINUTE_LIMIT=10
AI_UPSTREAM_TIMEOUT_MS=90000
